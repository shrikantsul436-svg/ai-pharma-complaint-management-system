# Groq API (get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_EXTRACTION_MODEL=gemma2-9b-it
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# Database - use either Postgres or MySQL connection string
# Postgres example:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/complaint_qms
# MySQL example (swap the line above for this one instead):
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/complaint_qms

# CORS
FRONTEND_ORIGIN=http://localhost:5173
